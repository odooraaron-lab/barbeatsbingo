# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables instead. Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Neon connection string. Adding Neon from Vercel's Storage tab sets this for you.
DATABASE_URL=postgres://user:password@your-host.neon.tech/neondb?sslmode=require

# First admin login. Created on the next deploy if it doesn't exist yet.
# Use a password of at least 10 characters, then change it after you log in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ── File storage (needed for uploads) ───────────────────────────────────────
# Cloudflare R2 (recommended, no download fees) or any S3-compatible store.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=barbeatsbingo-library
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for some self-hosted stores (MinIO etc.). Leave empty for R2 and AWS.
S3_FORCE_PATH_STYLE=

# ── Email (optional) ────────────────────────────────────────────────────────
# Turns on password-reset emails, customer invites and enquiry notifications.
# The sending domain (barbeatsbingo.com) must be verified in Resend → Domains.
RESEND_API_KEY=
# Optional: defaults to Bar Beats Bingo <hello@barbeatsbingo.com>
EMAIL_FROM=
# Where contact-form enquiries are emailed. Defaults to ADMIN_EMAIL.
CONTACT_EMAIL=

# ── Optional ────────────────────────────────────────────────────────────────
# Public address of the site, used in email links. Defaults to the address in use.
APP_URL=https://www.barbeatsbingo.com
